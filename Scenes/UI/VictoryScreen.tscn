[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://Scripts/UI/ResultScreen.gd" id="1"]
[ext_resource type="Script" path="res://Scripts/UI/WesternButton.gd" id="2_button"]

[node name="VictoryScreen" type="Control" node_paths=PackedStringArray("retry_button")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")
menu_scene_path = "res://Scenes/UI/StartMenu.tscn"
retry_button = NodePath("Center/VBox/Retry")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.045, 0.032, 0.022, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Center"]
custom_minimum_size = Vector2(480, 0)
layout_mode = 2
theme_override_constants/separation = 28

[node name="Title" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.84, 0.64, 0.28, 1)
theme_override_font_sizes/font_size = 72
text = "VICTORY"
horizontal_alignment = 1

[node name="Message" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "The sheriff has fallen."
horizontal_alignment = 1

[node name="Retry" type="Button" parent="Center/VBox"]
custom_minimum_size = Vector2(0, 64)
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "RETURN TO MENU"
script = ExtResource("2_button")
display_font_size = 28

[node name="Quit" type="Button" parent="Center/VBox"]
custom_minimum_size = Vector2(0, 64)
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "QUIT"
script = ExtResource("2_button")
display_font_size = 28

[connection signal="pressed" from="Center/VBox/Retry" to="." method="_on_retry_pressed"]
[connection signal="pressed" from="Center/VBox/Quit" to="." method="_on_quit_pressed"]
